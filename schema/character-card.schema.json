{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-card.schema.json",
  "title": "Карточка персонажа Soulstone Survivors",
  "description": "Только то, чего нет в справочнике вики. Статы, оружие, навыки и руны персонажа сайт берёт из data/reference/* по id. Все ссылки на игровые сущности — только id из справочника.",
  "type": "object",
  "required": ["schema_version", "character_id", "game_version", "guides"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.2" },
    "character_id": { "$ref": "#/$defs/id", "description": "id из reference/characters.json, например Sentinel" },
    "game_version": { "type": "string", "description": "Версия игры, к которой приведена карточка, например 1.5d" },
    "summary": { "$ref": "#/$defs/text", "description": "2-4 предложения: чем играет персонаж. Пересказ, не цитата." },
    "guides": {
      "type": "array",
      "description": "Гайды по персонажу из разных источников. Актуальные (current) и старые (legacy) хранятся рядом, сайт показывает их разными блоками.",
      "items": { "$ref": "#/$defs/guide" }
    },
    "derived": {
      "$ref": "#/$defs/derived",
      "description": "Выводы, которых нет в источниках (например, приоритет банов). Помечаются на сайте как «вывод, не из источника»."
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Чего не хватает: нет актуального гайда, нет данных о легендарном оружии на вики и т.п."
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
    "text": {
      "type": "object",
      "required": ["ru"],
      "additionalProperties": false,
      "properties": { "ru": { "type": "string" }, "en": { "type": "string" } }
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "confidence": { "enum": ["high", "medium", "low", "unconfirmed"] },
    "guide": {
      "type": "object",
      "required": ["source_id", "kind", "url", "title", "game_version", "updated", "fetched", "builds"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "description": "Например cubic-sentinel, steam-3251066730" },
        "kind": { "enum": ["current", "legacy"] },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "game_version": { "type": "string", "description": "Версия, указанная в самом гайде" },
        "updated": { "$ref": "#/$defs/date", "description": "Дата последнего обновления гайда" },
        "fetched": { "$ref": "#/$defs/date" },
        "legacy_note": { "$ref": "#/$defs/text", "description": "Только для legacy: что устарело в целом (по notes/meta-1.2-to-1.5d.md)" },
        "builds": { "type": "array", "items": { "$ref": "#/$defs/build" } }
      }
    },
    "build": {
      "type": "object",
      "required": ["id", "name", "archetypes", "skills", "runes", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "$ref": "#/$defs/text" },
        "weapon_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }], "description": "Оружие, если гайд его называет; иначе null" },
        "archetypes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["stack", "multiplier", "dot", "summon", "generalist", "synchrony", "other"] },
          "description": "Архетипы меты 1.5d из notes/meta-1.2-to-1.5d.md"
        },
        "core_mechanics": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ключевые эффекты и стаки (Aptitude, Ammunition, Dazed, Poison...). Имена как на вики."
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "role"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id", "description": "id из reference/skills.json" },
              "role": { "enum": ["core", "damage", "support", "optional"] },
              "obtained": { "enum": ["weapon_primary", "weapon_secondary", "pool", "rune"], "description": "Откуда берётся навык, если гайд это говорит" },
              "note": { "$ref": "#/$defs/text" }
            }
          }
        },
        "passives": {
          "type": "array",
          "description": "Пассивки (Powers) или статы в порядке приоритета гайда",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "power_id": { "$ref": "#/$defs/id" },
              "variant": { "type": "string", "description": "Для семейств пассивок: Skill Chain: Poison -> Projectile -> power_id SkillChain, variant «Poison -> Projectile»" },
              "power_name": { "type": "string", "description": "Английское название пассивки, которой нет в справочнике (вики неполная). Только если нет power_id." },
              "stat": { "type": "string", "description": "Если гайд называет стат, а не конкретную пассивку: Movement Speed, Critical Chance..." },
              "priority": { "enum": ["must", "high", "medium", "situational"] },
              "note": { "$ref": "#/$defs/text" }
            },
            "anyOf": [{ "required": ["power_id"] }, { "required": ["power_name"] }, { "required": ["stat"] }]
          }
        },
        "runes": {
          "type": "object",
          "required": ["tenacity", "versatility"],
          "additionalProperties": false,
          "properties": {
            "tenacity": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/rune_ref" } },
            "versatility": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/rune_ref" } }
          }
        },
        "titan_powers": { "type": "array", "items": { "type": "string" } },
        "playstyle": { "$ref": "#/$defs/text", "description": "Как играть, 1-3 предложения, пересказ" },
        "claims": {
          "type": "array",
          "description": "Утверждения с числами из гайда. Числа проверяются по вики.",
          "items": {
            "type": "object",
            "required": ["text", "status"],
            "additionalProperties": false,
            "properties": {
              "text": { "$ref": "#/$defs/text" },
              "status": { "enum": ["verified", "conflict", "unverified"] },
              "verified_by": { "enum": ["wiki", "game", "user"] },
              "detail": { "type": "string", "description": "Что именно сверено или в чём расхождение" }
            }
          }
        },
        "legacy_check": {
          "type": "array",
          "description": "Только для legacy-билдов: какие механики из выжимки 1.2 -> 1.5d задевают билд",
          "items": {
            "type": "object",
            "required": ["mechanic", "impact"],
            "additionalProperties": false,
            "properties": {
              "mechanic": { "type": "string" },
              "impact": { "enum": ["broken", "weakened", "unchanged", "buffed", "unknown"] },
              "note": { "$ref": "#/$defs/text" }
            }
          }
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "rune_ref": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id", "description": "id из reference/runes.json" },
        "variant": { "type": "string", "description": "Для рун-семейств: Skill Mastery: Projectile -> id SkillMastery, variant Projectile" }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "banish": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "reason"],
            "additionalProperties": false,
            "properties": {
              "target": { "type": "string", "description": "id навыка или пассивки, либо группа (например, тип навыков Holy)" },
              "builds": { "type": "array", "items": { "type": "string" }, "description": "id билдов, к которым относится; пусто = ко всем" },
              "reason": { "$ref": "#/$defs/text" }
            }
          }
        },
        "level_up_rules": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "basis": { "$ref": "#/$defs/text", "description": "На чём основаны выводы" }
      }
    }
  }
}
